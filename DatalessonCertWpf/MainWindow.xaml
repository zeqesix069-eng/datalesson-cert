<Window x:Class="DatalessonCertWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Урок Цифры: Сертификат"
        Width="700"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border Margin="14"
            Background="{StaticResource BgRootBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid Margin="22,16,22,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6C5CE7" Offset="0" />
                            <GradientStop Color="#00CEC9" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="УЦ"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Урок Цифры · Сертификат"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Быстрое получение и проверка ссылки на сертификат"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="—"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="Minimize_Click"
                            Margin="0,0,4,0" />
                    <Button Content="✕"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Ссылка на урок"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <TextBox x:Name="UrlBox"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     TextChanged="UrlBox_TextChanged"
                                     KeyDown="UrlBox_KeyDown" />
                            <TextBlock x:Name="UrlPlaceholder"
                                       Text="https://ui.datalesson.ru/data/?grade=2&amp;session_id=..."
                                       Foreground="#56607A"
                                       FontSize="13"
                                       Margin="14,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>

                        <Button Grid.Column="1"
                                Content="Вставить"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Paste_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Код урока (необязательно):"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <TextBox x:Name="SlugBox"
                                 Grid.Column="1"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 Padding="10,7" />
                    </Grid>

                    <Button x:Name="ResolveButton"
                            Content="Получить сертификат"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Resolve_Click" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Ссылка на сертификат"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ResultBox"
                                 Grid.Column="0"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 IsReadOnly="True"
                                 Margin="0,0,10,0" />

                        <Button x:Name="CopyButton"
                                Grid.Column="1"
                                Content="Копировать"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="False"
                                Click="Copy_Click"
                                Margin="0,0,8,0" />

                        <Button x:Name="OpenButton"
                                Grid.Column="2"
                                Content="Открыть"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="False"
                                Click="Open_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Background="#121621"
                    BorderBrush="#202638"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot"
                             Grid.Column="0"
                             Width="8"
                             Height="8"
                             Fill="#64708C"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0" />
                    <TextBlock x:Name="StatusText"
                               Grid.Column="1"
                               Text="Вставьте ссылку на тренажёр с параметром session_id."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
